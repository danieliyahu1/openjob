{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": { "mode": "token" },
    "http": { "endpoints": { "chatCompletions": { "enabled": true } } }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "model": { "primary": "opencode-go/deepseek-v4.1-flash" }
    },
    "entries": {
      "main": {
        "name": "main",
        "workspace": "/home/node/.openclaw/workspace",
        "identity": { "name": "job-searcher" },
        "model": "opencode-go/deepseek-v4.1-flash",
        "tools": {
          "fs": { "workspaceOnly": true },
          "allow": [
            "group:fs",
            "group:runtime",
            "group:memory",
            "group:messaging",
            "group:web",
            "ls",
            "skills_read",
            "skills_search",
            "ask_user",
            "browser"
          ],
          "exec": { "mode": "allowlist" }
        }
      }
    }
  },
  "tools": {
    "profile": "full",
    "sessions": { "visibility": "agent" },
    "agentToAgent": { "enabled": false }
  },
  "browser": {
    "noSandbox": true
  }
}
